# Postgres connection (standalone bare metal: use 127.0.0.1; docker compose web
# service must use the db hostname, e.g. postgresql://crumb:crumb@db:5432/crumb —
# host-side commands like prisma migrate deploy keep using 127.0.0.1)
DATABASE_URL="postgresql://crumb:crumb@127.0.0.1:5432/crumb"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://your-domain-or-ip:3000"

# Public origin — inlined into the client bundle at BUILD time (auth client
# baseURL). Must match BETTER_AUTH_URL exactly, no trailing slash.
# Docker: passed as a build arg (see compose build.args / RUNBOOK).
NEXT_PUBLIC_APP_URL="http://your-domain-or-ip:3000"

# App port (compose)
WEB_PORT=3000

# Postgres container defaults (compose)
POSTGRES_USER=crumb
POSTGRES_PASSWORD=crumb
POSTGRES_DB=crumb

# Mailgun (system emails + sign-in OTP). If unset, OTP codes fall back to the
# server console in development.
MAILGUN_API_KEY="replace-with-mailgun-api-key"
MAILGUN_DOMAIN="your-domain.mailgun.org"
MAILGUN_FROM_EMAIL="noreply@your-domain.mailgun.org"
MAILGUN_FROM_NAME="Crumb"
MAILGUN_REGION=us

# Super admin portal access (comma-separated emails)
PLATFORM_ADMIN_EMAILS=admin@boliflow.com

# Cron endpoints (HTTP bearer tokens). Schedulers call:
#   POST /api/cron/trial-emails    with CRON_TRIAL_SECRET
#   POST /api/cron/order-reminders with CRON_REMINDERS_SECRET
# Authorization: Bearer <value>. Generate with: openssl rand -hex 24
CRON_TRIAL_SECRET="replace-with-a-random-hex-token"
CRON_REMINDERS_SECRET="replace-with-a-random-hex-token"
