# Postgres connection (standalone baremetal: use localhost/127.0.0.1; docker compose: use db host from the web service)
DATABASE_URL="postgresql://crumb:crumb@127.0.0.1:5432/crumb"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://your-domain-or-ip:3000"

# App port (compose)
WEB_PORT=3000

# Postgres container defaults (compose)
POSTGRES_USER=crumb
POSTGRES_PASSWORD=crumb
POSTGRES_DB=crumb

# Mailgun (system emails). Copy keys from your Mailgun dashboard; if unset,
# OTP codes fall back to the server console in development.
MAILGUN_API_KEY="replace-with-mailgun-api-key"
MAILGUN_DOMAIN="your-domain.mailgun.org"
MAILGUN_FROM="noreply@your-domain.mailgun.org"
MAILGUN_URL="https://api.mailgun.net"
MAILGUN_REGION=us

# Optional; Mailgun webhook verification
MAILGUN_WEBHOOK_SIGNING_KEY="replace-with-mailgun-webhook-signing-key"

# Super admin portal access (comma-separated emails)
PLATFORM_ADMIN_EMAILS=admin@boliflow.com