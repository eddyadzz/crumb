generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IngredientMovementType {
  PURCHASE
  PRODUCTION
  ADJUSTMENT
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecipeStatus {
  ACTIVE
  DRAFT
}

enum ProductType {
  WHOLE
  PORTION
}

enum ProductMovementType {
  PRODUCED
  SOLD
  GIFTED
  SPOILED
  SAMPLE
  STAFF
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

enum StockPolicy {
  WARN
  BLOCK
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum NotificationType {
  LOW_STOCK
  TRIAL
  BILLING
  UPGRADE_REQUEST
  CUSTOMER_ORDER
  PRODUCTION
  SYSTEM
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  email                String?
  phone                String?
  country              String?
  status               TenantStatus          @default(ACTIVE)
  stockPolicy          StockPolicy           @default(WARN)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  notifLowStockEmail   Boolean               @default(true)
  notifOrdersEmail     Boolean               @default(true)
  notifProductionEmail Boolean               @default(true)
  notifBillingEmail    Boolean               @default(true)
  notifTrialEmail      Boolean               @default(true)
  users                User[]
  subscription         Subscription?
  subscriptionRequests SubscriptionRequest[]
  ingredients          Ingredient[]
  recipes              Recipe[]
  products             Product[]
  productionOrders     ProductionOrder[]
  sales                Sale[]
  customers            Customer[]
  customerOrders       CustomerOrder[]
  notifications        Notification[]

  @@index([status])
}

model Plan {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  description          String?
  monthlyPrice         Decimal               @default(0) @db.Decimal(10, 2)
  yearlyPrice          Decimal               @default(0) @db.Decimal(10, 2)
  active               Boolean               @default(true)
  sortOrder            Int                   @default(0)
  features             Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  subscriptions        Subscription[]
  subscriptionRequests SubscriptionRequest[]

  @@index([active, sortOrder])
}

model PaymentMethod {
  id        String                @id @default(cuid())
  name      String
  code      String                @unique
  details   String?
  currency  String?
  active    Boolean               @default(true)
  sortOrder Int                   @default(0)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  requests  SubscriptionRequest[]

  @@index([active, sortOrder])
}

model SubscriptionRequest {
  id              String                    @id @default(cuid())
  tenantId        String
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedPlanId String
  requestedPlan   Plan                      @relation(fields: [requestedPlanId], references: [id])
  paymentMethodId String
  paymentMethod   PaymentMethod             @relation(fields: [paymentMethodId], references: [id])
  billingInterval BillingInterval           @default(MONTHLY)
  referenceNumber String
  proofImage      String?
  notes           String?
  status          SubscriptionRequestStatus @default(PENDING)
  createdAt       DateTime                  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewer        User?                     @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewNotes     String?

  @@index([status])
  @@index([tenantId])
  @@index([requestedPlanId])
}

model Subscription {
  id                String             @id @default(cuid())
  tenantId          String             @unique
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId            String
  plan              Plan               @relation(fields: [planId], references: [id])
  status            SubscriptionStatus @default(TRIAL)
  billingInterval   BillingInterval    @default(MONTHLY)
  startsAt          DateTime           @default(now())
  endsAt            DateTime?
  trialEndsAt       DateTime?
  trialStartedAt    DateTime?
  trialEmailSentFor String?            @db.VarChar(16)
  autoRenew         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([planId])
  @@index([status])
}

model Ingredient {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  baseUnit          String
  purchaseQuantity  Float
  purchaseUnit      String
  purchaseCost      Float
  availableQuantity Float
  reorderLevel      Float
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  movements         IngredientMovement[]
  recipeIngredients RecipeIngredient[]

  @@index([tenantId])
}

model IngredientMovement {
  id           String                 @id @default(cuid())
  ingredientId String
  ingredient   Ingredient             @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type         IngredientMovementType
  quantity     Float
  notes        String?
  createdAt    DateTime               @default(now())

  @@index([ingredientId])
  @@index([createdAt])
}

model Recipe {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  instructions      String
  preparationTime   Int
  servingsProduced  Int
  status            RecipeStatus       @default(ACTIVE)
  packagingCost     Float              @default(0)
  utilityCost       Float              @default(0)
  laborCost         Float              @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  recipeIngredients RecipeIngredient[]
  products          Product[]
  productionItems   ProductionItem[]

  @@index([tenantId])
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float
  unit         String

  @@index([recipeId])
  @@index([ingredientId])
}

model ProductionOrder {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status      ProductionStatus @default(PLANNED)
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  items       ProductionItem[]

  @@index([tenantId])
  @@index([createdAt])
}

model ProductionItem {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  recipeId          String
  recipe            Recipe          @relation(fields: [recipeId], references: [id])
  batchCount        Int

  @@index([productionOrderId])
}

model Product {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeId           String
  recipe             Recipe              @relation(fields: [recipeId], references: [id])
  name               String
  sellingPrice       Float
  availableQuantity  Int
  type               ProductType
  movements          ProductMovement[]
  saleItems          SaleItem[]
  customerOrderItems CustomerOrderItem[]

  @@index([tenantId])
  @@index([recipeId])
}

model ProductMovement {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductMovementType
  quantity  Int
  createdAt DateTime            @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Sale {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  totalAmount Float
  createdAt   DateTime   @default(now())
  items       SaleItem[]

  @@index([tenantId])
  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float

  @@index([saleId])
}

model Customer {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  orders    CustomerOrder[]

  @@index([tenantId])
}

model CustomerOrder {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status       OrderStatus         @default(PENDING)
  deliveryDate DateTime?
  deliveryTime String?
  notes        String?
  totalAmount  Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        CustomerOrderItem[]

  @@index([tenantId])
  @@index([status])
  @@index([customerId])
}

model CustomerOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float

  @@index([orderId])
}

model Notification {
  id        String               @id @default(cuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      NotificationType     @default(SYSTEM)
  severity  NotificationSeverity @default(INFO)
  title     String
  message   String?
  link      String?
  read      Boolean              @default(false)
  emailed   Boolean              @default(false)
  createdAt DateTime             @default(now())
  readAt    DateTime?

  @@index([tenantId, read])
  @@index([tenantId, createdAt])
}

// --- Better Auth models ---

model User {
  id                           String                @id @default(cuid())
  tenantId                     String?
  tenant                       Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  role                         UserRole              @default(STAFF)
  isOwner                      Boolean               @default(false)
  name                         String
  email                        String                @unique
  emailVerified                Boolean               @default(false)
  image                        String?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  sessions                     Session[]
  accounts                     Account[]
  reviewedSubscriptionRequests SubscriptionRequest[]

  @@index([tenantId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
